# Скопируй в .env и заполни значения
# cp .env.example .env

# ─── Обязательные на Render (задаются в Dashboard) ────────────────
SECRET_KEY=замените-на-случайную-строку-50-символов
DEBUG=True
# ALLOWED_HOSTS=.onrender.com,localhost

# ─── База данных ─────────────────────────────────────────────────
# Если не задано — используется SQLite (для локальной разработки)
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ─── Email (опционально) ─────────────────────────────────────────
# DJANGO_EMAIL_USER=your@gmail.com
# DJANGO_EMAIL_PASSWORD=your_app_password
